{
  "manifest_version": 3,
  "name": "Biblia Focus - page bloquer",
  "version": "1.0.0",
  "description": "Bloquea sitios de entretenimiento y muestra versículos bíblicos aleatorios NVI. Opción de habilitar por 30 min. No se puede desactivar sin desinstalar.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "author": "Biblia Focus",
  "homepage_url": "https://github.com/bibliafocus/biblia-focus",
  "license": "AGPL-3.0-or-later",
  "offline_enabled": true
}